{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest tests/)",
      "Bash(python -m pytest tests)",
      "Bash(python -m compileall:*)",
      "Bash(pip install -e .)",
      "Bash(pip install -r requirements.txt)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git restore --staged:*)"
    ]
  }
}
