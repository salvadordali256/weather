# Data files
weather_data/
snowfall_graphs/
forecast_output/

# NOTE: do NOT blanket-ignore *.py here. The image installs the snowforecast
# package from src/ (pip install -e .) and runs the dashboard from web/apps/,
# so the Python sources must be in the build context.
